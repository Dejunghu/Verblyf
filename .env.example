# ---------------------------------------------------------------------------
# Verblyf — omgevingsvariabelen
# Kopieer naar .env.local en vul in. Commit .env.local nooit.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# Welke leveranciers actief zijn (komma-gescheiden): mock,amadeus
# Laat op "mock" staan zolang je nog geen API-sleutels hebt.
ACTIVE_SUPPLIERS="mock"      # bv. "mock,liteapi" of "liteapi,amadeus"
SUPPLIER_TIMEOUT_MS="8000"

# --- Amadeus Self-Service (gratis testsleutel: developers.amadeus.com) ------
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="test"            # test | production
AGENCY_EMAIL="boekingen@verblyf.com"

# Virtual credit card waarmee wij het hotel betalen bij bedbank-boekingen.
# In productie: nooit een echte kaart hardcoden — gebruik een VCC-provider
# (Adyen Issuing, Stripe Issuing, Wex) die per boeking een kaart uitgeeft.
VCC_VENDOR_CODE="VI"
VCC_NUMBER=""
VCC_EXPIRY=""
VCC_HOLDER="VERBLYF BV"

# --- LiteAPI (aanbevolen eerste leverancier: gratis sleutel, foto's inbegrepen)
LITEAPI_KEY=""

# --- Cloudinary (foto's van partnerhotels) ---------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Accounts (Better Auth) ------------------------------------------------
BETTER_AUTH_SECRET=""          # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@localhost:5432/verblyf?schema=public"

# --- E-mail (bevestigingen) ------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Verblyf <boekingen@verblyf.com>"
